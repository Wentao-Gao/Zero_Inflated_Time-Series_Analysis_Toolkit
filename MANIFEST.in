# Include the README files
include README.md
include README_CN.md
include LICENSE
include requirements.txt

# Include documentation
recursive-include docs *.md
recursive-include docs *.rst

# Include example data and scripts
include example_user_data.csv
recursive-include examples *.py
recursive-include experiments *.py
recursive-include experiments *.yaml
recursive-include experiments *.json

# Include test files
recursive-include tests *.py
include test_*.py

# Include notebooks if any
recursive-include notebooks *.ipynb

# Exclude compiled Python files
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude .git*
global-exclude .DS_Store